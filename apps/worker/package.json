{
  "name": "@personal-agent-os/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/start.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/start.ts",
    "start": "node dist/start.js",
    "test": "vitest run --environment node",
    "test:unit": "vitest run --environment node tests/unit",
    "test:integration": "vitest run --environment node tests/integration",
    "test:coverage": "vitest run --coverage --environment node",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "format": "echo 'no-op'"
  },
  "dependencies": {
    "@personal-agent-os/agent-sdk": "workspace:*",
    "@personal-agent-os/observability": "workspace:*",
    "@personal-agent-os/shared": "workspace:*",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.0",
    "vitest": "^3.2.4"
  }
}
