{
  "name": "@personal-agent-os/agent-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:openai": "OPENAI_ENABLE_LIVE_TESTS=true vitest run tests/integration/llm-generate-text-tool.integration.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "format": "echo 'no-op'"
  },
  "dependencies": {
    "@personal-agent-os/shared": "workspace:*",
    "axios": "^1.13.1",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "vitest": "^3.2.4"
  }
}
